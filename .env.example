# OpenWeatherMap current-weather endpoint
NEXT_PUBLIC_WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
# OpenWeatherMap 5-day/3-hour forecast endpoint
NEXT_PUBLIC_FORECAST_API_URL=https://api.openweathermap.org/data/2.5/forecast
# Your OpenWeatherMap API key (https://home.openweathermap.org/api_keys)
NEXT_PUBLIC_API_KEY=your_openweathermap_api_key
